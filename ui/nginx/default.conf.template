# Resolve the API host per request instead of once at startup, so nginx starts
# even when the API is not reachable yet and follows it across redeploys.
# NGINX_LOCAL_RESOLVERS is read from /etc/resolv.conf by the image entrypoint.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    # Replaces the Angular dev-server proxy: /api/accounts/x -> ${API_URL}/accounts/x
    location /api/ {
        set $api_upstream ${API_URL};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build assets can be cached indefinitely.
    location ~* \.(?:js|css|woff2?|svg|png|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Let Angular handle deep links such as /accounts/:accountId.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
