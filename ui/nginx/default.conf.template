server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Replaces the Angular dev-server proxy: /api/accounts/x -> ${API_URL}/accounts/x
    location /api/ {
        proxy_pass ${API_URL}/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build assets can be cached indefinitely.
    location ~* \.(?:js|css|woff2?|svg|png|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Let Angular handle deep links such as /accounts/:accountId.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
